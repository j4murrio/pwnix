#!/bin/sh

# sxhkd takes extra config files as positional arguments. NOT as repeated -c: that
# option assigns rather than accumulates, so a second -c would silently drop every
# binding shipped in sxhkdrc.
if ! pgrep -x sxhkd > /dev/null; then
    if [ -f "$HOME/.config/sxhkd.local" ]; then
        sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" "$HOME/.config/sxhkd.local" &
    else
        sxhkd &
    fi
fi

# Makes Java apps render properly. Not packaged for Debian, so its absence is fine.
command -v wmname > /dev/null && wmname LG3D &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width 0
bspc config top_padding 50
bspc config bottom_padding 1
bspc config left_padding 1
bspc config right_padding 1
bspc config window_gap 10
bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config focus_follows_pointer true
bspc config pointer_modifier mod1
bspc config normal_border_color '#414868'
bspc config focused_border_color '#bb9af7'
bspc config presel_feedback_color '#7aa2f7'

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

feh --bg-fill ~/Wallpapers/wallpaper.png &
~/.config/polybar/launch.sh &
# A local picom config replaces the shipped one outright rather than extending it:
# picom's format rejects duplicate settings, so an include could only add keys.
PICOM_CONF="$HOME/.config/picom/picom.conf"
[ -f "$HOME/.config/picom.local.conf" ] && PICOM_CONF="$HOME/.config/picom.local.conf"
pkill -x picom; picom --config "$PICOM_CONF" &

# Bring the volume down to 100% the very first time bspwm starts, for the case where
# no audio daemon was running when install.sh tried. The stamp makes it once and only
# once: forcing it on every login would fight whatever level you settle on.
if [ ! -f "$HOME/.cache/pwnix-volume-set" ] && command -v pamixer > /dev/null; then
    pamixer --set-volume 100 --unmute > /dev/null 2>&1
    mkdir -p "$HOME/.cache" && touch "$HOME/.cache/pwnix-volume-set"
fi

# Machine-local autostart (VM guest additions, anything not shared across machines).
# Lives outside the repo so a dotfiles update cannot discard it.
[ -f ~/.config/bspwm.local ] && . ~/.config/bspwm.local
